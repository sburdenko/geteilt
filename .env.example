# Copy to .env and fill in. .env is git-ignored and never leaves your machine.
# Local development value only — the server takes this from its environment.
POSTGRES_PASSWORD=geteilt_dev_only

# Signing key for access tokens. At least 32 characters, otherwise the API refuses to start.
# Generate one with:  openssl rand -base64 48
JWT_KEY=

# Key that IBANs are encrypted with in the database. Exactly 32 bytes, base64.
# Generate one with:  openssl rand -base64 32
# Losing it makes every stored IBAN unreadable, so on a server it is backed up apart from the data.
IBAN_KEY=
